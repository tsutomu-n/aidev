# Generated Python files and local environments, including nested ones
__pycache__/
*.py[cod]
.venv/
venv/

# Local environment values; reviewed templates may be tracked
.env
.env.*
!.env.example

# Machine-specific acceptance evidence and disposable test repositories
/verification/

# Local references and session state, outside the source release
/.ref/
/.ai_memory/
/.codex/SP_STATE.md

# Repo-local aidev state and backups
/.aidev/

# Provider runtime and indexes; keep shared project configuration visible
/.serena/runtime/
/.serena/cache/
/.serena/memories/
/.serena/logs/
/.serena/project.local.yml
/.code-review-graph/
/graphify-out/

# Derived Terrain packs and local metadata; shared context stays visible
/.terrain/agent/repomix.md
/.terrain/agent/meta.json
/.terrain/agent/meta-inputs*
/.terrain/.meta/
