+#[cfg(test)]
+mod agent_context_recovery_tests {
+    use super::*;
+
+    #[test]
+    fn counts_first_heading_and_unicode_characters() {
+        let headings = crate::language::ResolvedLanguage::En.agent_context_sections();
+        let body = headings.map(|title| format!("## {title}\n")).join("\n");
+        assert_eq!(context_section_count(&body), 7);
+        assert_eq!(
+            context_section_count("## First\n### Child\ninline ## Text\n## Last"),
+            2
+        );
+
+        let short = format!("{body}{}", "語".repeat(180));
+        assert!(short.len() >= 500);
+        assert!(short.chars().count() < 500);
+        assert!(!context_body_ready(&short));
+        let ready = format!("{short}{}", "語".repeat(500 - short.chars().count()));
+        assert_eq!(ready.chars().count(), 500);
+        assert!(context_body_ready(&ready));
+    }
+
+    #[test]
+    fn normalizes_repo_paths_without_touching_siblings_or_urls() {
+        let root = "/home/example/repo";
+        for (input, expected) in [
+            ("/home/example/repo", "."),
+            ("`/home/example/repo/`", "`.`"),
+            ("`/home/example/repo/src/日本.py`", "`src/日本.py`"),
+            (
+                "[source](/home/example/repo/src/a.py)",
+                "[source](src/a.py)",
+            ),
+            (r"/home/example/repo\src\a.py", "src/a.py"),
+            (
+                "/home/example/repo-other/src/a.py",
+                "/home/example/repo-other/src/a.py",
+            ),
+            (
+                "/home/example/repo.bak/src/a.py",
+                "/home/example/repo.bak/src/a.py",
+            ),
+            (
+                "/prefix/home/example/repo/src/a.py",
+                "/prefix/home/example/repo/src/a.py",
+            ),
+            (
+                "https://example.test/home/example/repo/src/a.py",
+                "https://example.test/home/example/repo/src/a.py",
+            ),
+            (
+                "file:///home/example/repo/src/a.py",
+                "file:///home/example/repo/src/a.py",
+            ),
+            (
+                "https://example.test/?path=/home/example/repo/src/a.py",
+                "https://example.test/?path=/home/example/repo/src/a.py",
+            ),
+        ] {
+            assert_eq!(normalize_context_repo_paths(input, root), expected, "{input}");
+        }
+        assert_eq!(
+            normalize_context_repo_paths(
+                concat!(
+                    r"`C:\Users\example\repo\src\a.py` C:/Users/example/repo ",
+                    r"C:\Users\example\repo-other\a.py"
+                ),
+                r"C:\Users\example\repo\",
+            ),
+            r"`src/a.py` . C:\Users\example\repo-other\a.py"
+        );
+        assert_eq!(
+            normalize_context_repo_paths(r"C:\repo\src\a.py", r"\\?\C:\repo"),
+            "src/a.py"
+        );
+        assert_eq!(
+            normalize_context_repo_paths(
+                r"\\server\share\repo\src\a.py",
+                r"\\?\UNC\server\share\repo",
+            ),
+            "src/a.py"
+        );
+
+        let cwd = std::env::current_dir().unwrap();
+        let temp = tempfile::tempdir_in(&cwd).unwrap();
+        let relative = temp.path().strip_prefix(&cwd).unwrap();
+        let input = format!("`{}/src/a.py`", temp.path().display());
+        assert_eq!(
+            normalize_context_repo_paths(&input, &relative.display().to_string()),
+            "`src/a.py`"
+        );
+        let current_path = format!("`{}/src/a.py`", cwd.display());
+        assert_eq!(normalize_context_repo_paths(&current_path, "."), "`src/a.py`");
+        let missing = relative.join("missing");
+        assert_eq!(
+            normalize_context_repo_paths(&input, &missing.display().to_string()),
+            input
+        );
+    }
