+    #[test]
+    fn writer_and_restamp_save_correct_paths_and_metadata_without_llm() {
+        let _lock = crate::registry::registry_test_lock();
+        let temp = tempfile::tempdir().unwrap();
+        struct RegistryEnv(Option<std::ffi::OsString>);
+        impl Drop for RegistryEnv {
+            fn drop(&mut self) {
+                unsafe {
+                    if let Some(previous) = &self.0 {
+                        std::env::set_var("TERRAIN_REGISTRY_FILE", previous);
+                    } else {
+                        std::env::remove_var("TERRAIN_REGISTRY_FILE");
+                    }
+                }
+            }
+        }
+        let _registry_env = RegistryEnv(std::env::var_os("TERRAIN_REGISTRY_FILE"));
+        unsafe {
+            std::env::set_var("TERRAIN_REGISTRY_FILE", temp.path().join("registry.json"));
+        }
+        let repo = temp.path().join("repo");
+        std::fs::create_dir(&repo).unwrap();
+        for args in [
+            vec!["init", "--quiet"],
+            vec![
+                "-c",
+                "user.name=Recovery Test",
+                "-c",
+                "user.email=recovery@example.test",
+                "-c",
+                "commit.gpgsign=false",
+                "-c",
+                "core.hooksPath=/dev/null",
+                "commit",
+                "--quiet",
+                "--allow-empty",
+                "-m",
+                "recovery fixture",
+            ],
+        ] {
+            let output = std::process::Command::new("git")
+                .args(args)
+                .current_dir(&repo)
+                .output()
+                .unwrap();
+            assert!(
+                output.status.success(),
+                "{}",
+                String::from_utf8_lossy(&output.stderr)
+            );
+        }
+        let repo_path = repo.display().to_string();
+        let slug = "agent-context-recovery";
+        crate::registry::register_project(slug, &repo_path).unwrap();
+        let paths = KnowledgePaths::new();
+        let sibling = format!("{repo_path}-sibling/src/keep.py");
+        let body = crate::language::ResolvedLanguage::En
+            .agent_context_sections()
+            .map(|title| format!("## {title}\n\n{}\n", "日本語の確認。".repeat(20)))
+            .join("\n");
+        let input = format!(
+            "{body}\nRoot: `{repo_path}`\nCode: `{repo_path}/src/main.py`\nSibling: `{sibling}`\n"
+        );
+        let meta = write_agent_context(&paths, slug, &repo_path, &input).unwrap();
+        let doc = read_doc(paths.agent_context_main(slug)).unwrap();
+        assert_eq!(context_section_count(&doc.body), 7);
+        assert_eq!(meta.section_count, 7);
+        assert_eq!(meta.char_count, doc.body.chars().count());
+        assert!(doc.body.contains("Root: `.`"));
+        assert!(doc.body.contains("Code: `src/main.py`"));
+        assert!(doc.body.contains(&format!("Sibling: `{sibling}`")));
+        assert!(!doc.body.contains(&format!("`{repo_path}`")));
+        assert!(!doc.body.contains(&format!("{repo_path}/")));
+        assert_eq!(doc.frontmatter.source.as_deref(), Some("."));
+        assert_eq!(meta.repo_path, ".");
+        assert!(meta.baseline_git_head.is_some());
+        assert_eq!(meta.baseline_git_head, git_snapshot(&repo_path).head);
+        assert_eq!(read_agent_context_status(&paths, slug).section_count, 7);
+        assert!(read_agent_context_status(&paths, slug).ready);
+
+        let original = std::fs::read(paths.agent_context_main(slug)).unwrap();
+        let restamped = refresh_agent_context_baseline(&paths, slug, &repo_path).unwrap();
+        assert_eq!(std::fs::read(paths.agent_context_main(slug)).unwrap(), original);
+        assert_eq!(restamped.section_count, 7);
+        assert_eq!(restamped.char_count, doc.body.chars().count());
+        assert_eq!(restamped.generated_at, meta.generated_at);
+        assert_eq!(restamped.language, meta.language);
+        assert_eq!(restamped.baseline_git_head, meta.baseline_git_head);
+        assert_eq!(restamped.repo_path, meta.repo_path);
