+/// Make standalone references to this repository portable, leaving siblings and URLs intact.
+fn normalize_context_repo_paths(body: &str, repo_path: &str) -> String {
+    let mut root = repo_path.replace('\\', "/");
+    let windows_absolute = root.as_bytes().first().is_some_and(u8::is_ascii_alphabetic)
+        && root.as_bytes().get(1..3) == Some(b":/");
+    if !root.starts_with('/') && !windows_absolute {
+        let Ok(absolute) = std::fs::canonicalize(repo_path) else {
+            return body.to_string();
+        };
+        root = absolute.to_string_lossy().replace('\\', "/");
+    }
+    // Windows canonicalization uses a verbatim prefix; documents use ordinary paths.
+    if let Some(unc) = root.strip_prefix("//?/UNC/") {
+        root = format!("//{unc}");
+    } else if let Some(plain) = root.strip_prefix("//?/") {
+        root = plain.to_string();
+    }
+    let root = root.trim_end_matches('/');
+    if root.is_empty() {
+        return body.to_string();
+    }
+    let root_pattern = root
+        .split('/')
+        .map(regex::escape)
+        .collect::<Vec<_>>()
+        .join(r"[/\\]");
+    let re = regex::Regex::new(&format!(
+        r#"{root_pattern}(?:[/\\][^\s`"'<>\[\](){{}}|,;]*)?"#
+    ))
+    .expect("context repository path regex");
+    re.replace_all(body, |caps: &regex::Captures<'_>| {
+        let matched = caps.get(0).expect("repository path match");
+        let before = &body[..matched.start()];
+        let after = &body[matched.end()..];
+        let starts_reference = before.chars().next_back().is_none_or(|c| {
+            c.is_whitespace() || matches!(c, '`' | '"' | '\'' | '(' | '[' | '{' | '<' | '=' | '|')
+        });
+        let ends_reference = after.chars().next().is_none_or(|c| {
+            c.is_whitespace()
+                || matches!(c, '`' | '"' | '\'' | ')' | ']' | '}' | '>' | ',' | ';' | '|')
+        });
+        // A query parameter can place '=' immediately before the path inside a URL.
+        let in_url = before
+            .split_whitespace()
+            .next_back()
+            .is_some_and(|token| token.contains("://"));
+        if !starts_reference || !ends_reference || in_url {
+            return matched.as_str().to_string();
+        }
+        let portable = matched.as_str().replace('\\', "/");
+        let relative = portable[root.len()..].trim_start_matches('/');
+        if relative.is_empty() {
+            ".".to_string()
+        } else {
+            relative.to_string()
+        }
+    })
+    .into_owned()
+}
